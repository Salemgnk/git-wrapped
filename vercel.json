{
  "rewrites": [
    { "source": "/", "destination": "/web/" },
    { "source": "/wrapped.js", "destination": "/web/wrapped.js" },
    { "source": "/wrapped.css", "destination": "/web/wrapped.css" },
    { "source": "/fonts.css", "destination": "/web/fonts.css" },
    { "source": "/fonts/:f", "destination": "/web/fonts/:f" }
  ],
  "cleanUrls": true
}
